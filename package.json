{
  "name": "positive-player",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:tv dev:remote",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "dev:tv": "vite --host 0.0.0.0",
    "dev:remote": "node --experimental-strip-types --watch server/index.mjs",
    "start": "node --experimental-strip-types server/index.mjs",
    "test:server": "node --experimental-strip-types --test server/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "sirv": "^3.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.81.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.81.0",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
