{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/remote-ws.mjs": {
      "maxDuration": 300,
      "includeFiles": "{server/**,src/lib/remoteProtocol.ts,src/data/channels.ts}"
    }
  },
  "rewrites": [
    {
      "source": "/remote-ws",
      "destination": "/api/remote-ws"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
