# Restrict this key by HTTP referrer in Google Cloud.
VITE_YOUTUBE_API_KEY=

# Website build: leave empty for local development or single-server hosting.
# On Vercel, REQUIRED: use the public address of the separate persistent relay.
# VITE_REMOTE_WS_URL=wss://YOUR-RELAY-HOST/remote-ws
VITE_REMOTE_WS_URL=

# Persistent relay runtime: exact website origin (no trailing slash).
PUBLIC_ORIGIN=https://1988-in.vercel.app
# Enable only when behind a trusted proxy and the relay port is private.
TRUST_PROXY=0
PORT=8787
