# Restrict this key by HTTP referrer in Google Cloud.
VITE_YOUTUBE_API_KEY=

# Google Tag Manager container. Public. Leave blank to omit the tag.
VITE_GTM_ID=GTM-ABCDEFGH

# Files viewer notes as GitHub issues. Leave the token blank to keep the form closed.
# Use a fine-grained token with Issues: Read and write on GITHUB_FEEDBACK_REPO.
# Point the repo at a private repository if notes should stay private.
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=tusharv/positive-player
